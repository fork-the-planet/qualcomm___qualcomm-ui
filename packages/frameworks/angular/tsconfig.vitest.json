{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.angular-lib-strict.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": "./",
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "paths": {
      "~test-utils": ["./test/index.ts"],
      // required for analog vitest to work
      "@qualcomm-ui/angular/*": ["./src/*/index.ts"],
      "@qualcomm-ui/angular-core/*": ["../angular-core/src/*"],
      "@qualcomm-ui/core/*": ["../../common/core/dist/*"],
      "@qualcomm-ui/dom/*": ["../../common/core/dist/*"],
      "@qualcomm-ui/qds-core/*": ["../../common/qds-core/dist/*"],
      "@qualcomm-ui/utils/*": ["../../common/utils/dist/*"]
    }
  },
  "include": ["./src/**/*.spec.ts"],
  "references": [
    {
      "path": "../angular-core/tsconfig.angular-lib.json"
    },
    {
      "path": "./tsconfig.angular-lib.json"
    },
    {
      "path": "./tsconfig.figma.json"
    },
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
