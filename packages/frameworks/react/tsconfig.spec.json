{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.strict.json",
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "types": ["vitest"],
    "paths": {
      "@qualcomm-ui/react/*": ["./src/*/index.ts"],
      "~test-utils/runner": ["./test-utils/runner.ts"]
    }
  },
  "include": ["./src/**/*.spec.tsx", "./test-utils"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "../react-test-utils/tsconfig.lib.json"
    },
    {
      "path": "../../common/core/tsconfig.lib.json"
    }
  ]
}
