{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.strict.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "files": ["types.d.ts"],
    "paths": {
      // fixes WebStorm usage detection, not used otherwise
      "@qualcomm-ui/core/*": ["../../common/core/src/*"],
      "@qualcomm-ui/dom/*": ["../../common/dom/src/*"],
      "@qualcomm-ui/mdx-common/*": ["../../common/mdx-common/src/*"],
      "@qualcomm-ui/mdx-vite/*": ["../../common/mdx-vite/src/*"],
      "@qualcomm-ui/qds-core/*": ["../../common/qds-core/src/*"],
      "@qualcomm-ui/react/*": ["../react/src/*"],
      "@qualcomm-ui/react-core/*": ["../react-core/src/*"],
      "@qualcomm-ui/react-mdx/*": ["../react-mdx/src/*"],
      "@qualcomm-ui/utils/*": ["../../common/utils/src/*"]
    },
  },
  "include": ["./src"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
