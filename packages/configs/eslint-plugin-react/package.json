{
  "name": "@qualcomm-ui/eslint-plugin-react",
  "version": "1.0.0",
  "description": "ESLint plugin for enforcing best-practices with QUI React component consumption",
  "author": "Ryan Bower",
  "license": "BSD-3-Clause-Clear",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "sideEffects": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "plugin",
    "react",
    "accessibility",
    "a11y"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./plugin": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "build:watch": "tsc -p tsconfig.lib.json --watch",
    "clean": "rm -rf dist",
    "test": "pnpm build && vitest -c vitest.config.ts --run",
    "test:unit:ci": "pnpm build && cross-env NODE_OPTIONS='' vitest -c vitest.config.ts --run --pool=threads --no-file-parallelism",
    "prepublishOnly": "pnpm build && qui-cli pre-publish",
    "postpublish": "qui-cli post-publish"
  },
  "devDependencies": {
    "@eslint/core": "^1.0.0",
    "@qualcomm-ui/cli": "workspace:^1.0.3",
    "@qualcomm-ui/tsconfig": "workspace:*",
    "@typescript-eslint/utils": "catalog:",
    "@typescript-eslint/rule-tester": "8.48.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "^4.0.8"
  }
}
