{
  "name": "@qualcomm-ui/eslint-plugin-angular",
  "version": "1.2.0",
  "description": "ESLint plugin for enforcing best-practices with QUI Angular component consumption",
  "author": "Ryan Bower",
  "license": "BSD-3-Clause-Clear",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "plugin",
    "angular",
    "accessibility",
    "a11y"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "run-s clean build:js build:types",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:watch": "run-p watch:js watch:types",
    "watch:js": "vite build -w",
    "watch:types": "tsc -p tsconfig.lib.json -w --preserveWatchOutput",
    "clean": "shx rm -rf dist",
    "lint": "eslint --quiet",
    "test": "turbo build --filter @qualcomm-ui/eslint-plugin-angular && vitest -c vitest.config.ts --run",
    "test:unit:ci": "pnpm build && cross-env NODE_OPTIONS='' vitest -c vitest.config.ts --run --pool=threads --no-file-parallelism",
    "prepublishOnly": "pnpm build && qui-cli pre-publish",
    "postpublish": "qui-cli post-publish"
  },
  "devDependencies": {
    "@eslint/core": "^1.0.0",
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/esbuild": "catalog:",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/vite": "catalog:",
    "@typescript-eslint/rule-tester": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "angular-eslint": "^21.3.1",
    "esbuild": "catalog:",
    "npm-run-all2": "catalog:",
    "shx": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  }
}
