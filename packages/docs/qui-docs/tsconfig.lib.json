{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.react-docs.json",
  "compilerOptions": {
    "baseUrl": "./",
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo",
    "paths": {
      // fixes WebStorm usage detection, not used otherwise
      "~assets/*": ["./src/assets/*"],
      "~components/*": ["./src/components/*"],
      "~utils/*": ["./src/utils/*"],
    }
  },
  "include": [
    "types.d.ts",
    "./src"
  ],
  "references": [
    {
      "path": "../../frameworks/react/tsconfig.lib.json"
    },
    {
      "path": "../../common/mdx-vite/tsconfig.lib.json"
    }
  ]
}
