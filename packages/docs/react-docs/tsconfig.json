{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.react-docs.json",
  "compilerOptions": {
    "baseUrl": "./",
    "moduleResolution": "bundler",
    "paths": {
      // fixes WebStorm usage detection, not used otherwise
      "@qualcomm-ui/react/*": ["../../frameworks/react/src/*"],
      "@qualcomm-ui/react-core/*": ["../../frameworks/react-core/src/*"],
      "@qualcomm-ui/core/*": ["../../common/core/src/*"],
      "@qualcomm-ui/dom/*": ["../../common/dom/src/*"],
      "@qualcomm-ui/qds-core/*": ["../../common/qds-core/src/*"],
      "@qualcomm-ui/utils/*": ["../../common/utils/src/*"]
    }
  },
  "include": ["./src/**/*.mdx"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.mdx.json"
    },
    {
      "path": "./tsconfig.node.json"
    },
  ]
}
