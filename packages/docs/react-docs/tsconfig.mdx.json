{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "baseUrl": "./",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "paths": {
      "~assets/*": ["./src/assets/*"],
      "~components/*": ["./src/components/*"],
      "~utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "./src/**/*.mdx"
  ]
}
