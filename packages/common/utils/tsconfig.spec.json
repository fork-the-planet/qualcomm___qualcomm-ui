{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.strict.json",
  "compilerOptions": {
    "jsx": "preserve",
    "strictPropertyInitialization": false,
    "composite": true,
    "rootDir": "./src",
    "paths": {
      "@qualcomm-ui/utils/*": ["./src/*/index.ts"]
    }
  },
  "include": [
    "./src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
