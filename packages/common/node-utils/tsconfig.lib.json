{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.super-strict.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": "./",
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo",
    "paths": {
      "@qualcomm-ui/node-utils/*": ["./src/*/index.ts"]
    }
  },
  "include": ["./src"],
  "exclude": ["./src/**/*.spec.ts"]
}
