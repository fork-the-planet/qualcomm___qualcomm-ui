{
  "name": "@qualcomm-ui/node-utils",
  "version": "1.0.1",
  "description": "A Node.js utility library",
  "author": "Ryan Bower",
  "license": "BSD-3-Clause-Clear",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/stub.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "require": "./dist/*/index.cjs",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "run-s clean build:js build:ts",
    "clean": "shx rm -rf node_modules/.tmp/tsbuildinfo dist/**/*.js dist/**/*.cjs dist/**/*.mjs dist/**/*.js.map",
    "build:js": "tsx build.ts",
    "build:ts": "tsc -b tsconfig.lib.json",
    "dev": "run-p watch:js watch:ts",
    "watch:js": "tsx build.ts --watch",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput",
    "lint": "eslint --quiet",
    "prepublishOnly": "qui-cli pre-publish",
    "postpublish": "qui-cli post-publish",
    "test": "vitest --run -c vitest.config.ts",
    "test:unit:ci": "cross-env NODE_OPTIONS='' vitest -c vitest.config.ts --run --pool=threads"
  },
  "devDependencies": {
    "@qualcomm-ui/cli": "workspace:^1.0.6",
    "@qualcomm-ui/esbuild": "workspace:^1.0.5",
    "@qualcomm-ui/tsconfig": "workspace:^1.0.4",
    "@types/node": "~24.9.2",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "esbuild": "^0.25.8",
    "glob": "catalog:",
    "pretty-ms": "^9.3.0",
    "shx": "^0.4.0",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "^4.0.8"
  }
}
