{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo-spec"
  },
  "include": ["./src/**/*.spec.ts", "./src/**/__tests__/**/*.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
